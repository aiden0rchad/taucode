{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taucode",
  "version": "0.7.68",
  "identifier": "dev.taucode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "taucode",
        "width": 1200,
        "height": 700,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 24
        },
        "transparent": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "iOS": {
      "frameworks": [
        "libz.tbd",
        "libiconv.tbd"
      ]
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "resources": {
      "../engines/pi/extensions/LICENSE": "engines/pi/extensions/LICENSE",
      "../engines/pi/extensions/lib/connectors.ts": "engines/pi/extensions/lib/connectors.ts",
      "../engines/pi/extensions/lib/policy.ts": "engines/pi/extensions/lib/policy.ts",
      "../engines/pi/extensions/taucode-gate.ts": "engines/pi/extensions/taucode-gate.ts",
      "../engines/pi/extensions/taucode-subagents.ts": "engines/pi/extensions/taucode-subagents.ts",
      "../engines/pi/no-accounts.mjs": "engines/pi/no-accounts.mjs",
      "../engines/pi/package-lock.json": "engines/pi/package-lock.json",
      "../engines/pi/package.json": "engines/pi/package.json",
      "../engines/browser/package-lock.json": "engines/browser/package-lock.json",
      "../engines/browser/package.json": "engines/browser/package.json",
      "../engines/computer/pyproject.toml": "engines/computer/pyproject.toml",
      "../engines/computer/taucode_cua/__init__.py": "engines/computer/taucode_cua/__init__.py",
      "../engines/computer/taucode_cua/actions.py": "engines/computer/taucode_cua/actions.py",
      "../engines/computer/taucode_cua/images.py": "engines/computer/taucode_cua/images.py",
      "../engines/computer/taucode_cua/requests.py": "engines/computer/taucode_cua/requests.py",
      "../engines/computer/taucode_cua/server.py": "engines/computer/taucode_cua/server.py",
      "../engines/computer/taucode_cua/vendor/__init__.py": "engines/computer/taucode_cua/vendor/__init__.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/LICENSE": "engines/computer/taucode_cua/vendor/agent_s3/LICENSE",
      "../engines/computer/taucode_cua/vendor/agent_s3/NOTICE": "engines/computer/taucode_cua/vendor/agent_s3/NOTICE",
      "../engines/computer/taucode_cua/vendor/agent_s3/__init__.py": "engines/computer/taucode_cua/vendor/agent_s3/__init__.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/agents/__init__.py": "engines/computer/taucode_cua/vendor/agent_s3/agents/__init__.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/agents/agent_s.py": "engines/computer/taucode_cua/vendor/agent_s3/agents/agent_s.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/agents/grounding.py": "engines/computer/taucode_cua/vendor/agent_s3/agents/grounding.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/agents/worker.py": "engines/computer/taucode_cua/vendor/agent_s3/agents/worker.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/core/__init__.py": "engines/computer/taucode_cua/vendor/agent_s3/core/__init__.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/core/engine.py": "engines/computer/taucode_cua/vendor/agent_s3/core/engine.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/core/mllm.py": "engines/computer/taucode_cua/vendor/agent_s3/core/mllm.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/core/module.py": "engines/computer/taucode_cua/vendor/agent_s3/core/module.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/memory/__init__.py": "engines/computer/taucode_cua/vendor/agent_s3/memory/__init__.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/memory/procedural_memory.py": "engines/computer/taucode_cua/vendor/agent_s3/memory/procedural_memory.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/utils/__init__.py": "engines/computer/taucode_cua/vendor/agent_s3/utils/__init__.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/utils/common_utils.py": "engines/computer/taucode_cua/vendor/agent_s3/utils/common_utils.py",
      "../engines/computer/taucode_cua/vendor/agent_s3/utils/formatters.py": "engines/computer/taucode_cua/vendor/agent_s3/utils/formatters.py",
      "../engines/computer/uv.lock": "engines/computer/uv.lock"
    }
  },
  "plugins": {}
}
