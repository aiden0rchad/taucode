{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taucode",
  "version": "0.7.68",
  "identifier": "dev.taucode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "taucode",
        "width": 1200,
        "height": 700,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 24
        },
        "transparent": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "iOS": {
      "frameworks": [
        "libz.tbd",
        "libiconv.tbd"
      ]
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "resources": {
      "../engines/pi/no-accounts.mjs": "engines/pi/no-accounts.mjs",
      "../engines/pi/package-lock.json": "engines/pi/package-lock.json",
      "../engines/pi/package.json": "engines/pi/package.json",
      "../engines/browser/package-lock.json": "engines/browser/package-lock.json",
      "../engines/browser/package.json": "engines/browser/package.json",
      "../engines/computer/pyproject.toml": "engines/computer/pyproject.toml",
      "../engines/computer/uv.lock": "engines/computer/uv.lock",
      "target/engine-resources/computer/taucode_cua/": "engines/computer/taucode_cua/",
      "target/engine-resources/pi/extensions/": "engines/pi/extensions/",
      "../engines/pi/.gitignore": "engines/pi/.gitignore",
      "../engines/browser/.gitignore": "engines/browser/.gitignore",
      "../engines/computer/README.md": "engines/computer/README.md",
      "../engines/computer/.gitignore": "engines/computer/.gitignore"
    }
  },
  "plugins": {}
}
