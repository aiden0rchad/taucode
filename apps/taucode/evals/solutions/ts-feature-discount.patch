--- /dev/null
+++ b/hard/invoice/money.test.ts
@@ -0,0 +1,7 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {allocateDiscount} from './money.ts';
+test('allocator handles remainders without mutating frozen input',()=>{
+  const amounts=Object.freeze([2,3,5]);
+  assert.deepEqual(allocateDiscount(amounts as unknown as number[],3),[1,1,1]);
+});
