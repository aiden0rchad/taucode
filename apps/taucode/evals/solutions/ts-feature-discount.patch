--- a/hard/invoice/money.ts
+++ b/hard/invoice/money.ts
@@ -1 +1,12 @@
 export const sum = (xs:number[]) => xs.reduce((a,b)=>a+b,0);
+export function allocateDiscount(amounts:number[],discount:number):number[] {
+  const total=sum(amounts);
+  if(!Number.isInteger(discount)||discount<0||amounts.some(n=>!Number.isInteger(n)||n<0)||discount>total) throw new RangeError('discount');
+  if(total===0) return amounts.map(()=>0);
+  const exact=amounts.map(n=>n*discount/total);
+  const shares=exact.map(Math.floor);
+  const order=exact.map((n,i)=>({i,fraction:n-shares[i]})).sort((a,b)=>b.fraction-a.fraction||a.i-b.i);
+  const remaining=discount-sum(shares);
+  for(let i=0;i<remaining;i++) shares[order[i].i]++;
+  return shares;
+}
